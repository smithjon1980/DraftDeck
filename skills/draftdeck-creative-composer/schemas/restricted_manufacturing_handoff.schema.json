{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftdeck.local/schemas/restricted_manufacturing_handoff.schema.json",
  "title": "DraftDeck Creative Composer manufacturing handoff (candidate)",
  "description": "Positive-allowlist schema: upstream Spark, prompt and rejected candidates have no permitted fields. Schema validation alone is not an access control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "run_id",
    "selected_artwork",
    "editable_copy",
    "visual_constraints",
    "approval_receipts",
    "provenance_join_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-candidate"
    },
    "route_id": {
      "const": "draftdeck-creative-recomposition-v1-candidate"
    },
    "run_id": {
      "type": "string",
      "minLength": 8,
      "not": {
        "pattern": "^(NOT_ESTABLISHED|REPLACE_WITH|PENDING)"
      }
    },
    "selected_artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "media_type",
        "rights_scope"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(\\.\\./|https?://|REPLACE_WITH|NOT_ESTABLISHED)"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "media_type": {
          "enum": [
            "image/webp",
            "image/png",
            "image/svg+xml"
          ]
        },
        "rights_scope": {
          "type": "string",
          "minLength": 3,
          "not": {
            "const": "NOT_ESTABLISHED"
          }
        }
      }
    },
    "editable_copy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id",
          "text",
          "source_ref"
        ],
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^REPLACE_WITH"
            }
          },
          "source_ref": {
            "type": "string",
            "minLength": 2,
            "not": {
              "const": "NOT_ESTABLISHED"
            }
          }
        }
      }
    },
    "visual_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "canvas_aspect_ratio",
        "requirements",
        "exclusions"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 2,
          "not": {
            "const": "NOT_ESTABLISHED"
          }
        },
        "canvas_aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval_receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_1_direction_id",
        "gate_2_artwork_selection_id"
      ],
      "properties": {
        "gate_1_direction_id": {
          "type": "string",
          "minLength": 3,
          "not": {
            "const": "NOT_ESTABLISHED"
          }
        },
        "gate_2_artwork_selection_id": {
          "type": "string",
          "minLength": 3,
          "not": {
            "const": "NOT_ESTABLISHED"
          }
        }
      }
    },
    "provenance_join_id": {
      "type": "string",
      "minLength": 3,
      "not": {
        "const": "NOT_ESTABLISHED"
      }
    }
  }
}
