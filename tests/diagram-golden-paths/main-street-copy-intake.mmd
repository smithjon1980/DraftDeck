flowchart LR
    subgraph INTAKE["01 / INTAKE + VALIDATION"]
        direction TB
        A["Customer print request"] --> B{"All required fields and copy count known?"}
        B -->|No| C["HOLD: request missing information"]
        C --> B
    end
    subgraph PRODUCTION["02 / REVIEWED PRODUCTION"]
        direction TB
        D["Create reviewed work order"] --> E["Authorized production"]
    end
    subgraph QUALITY["03 / INSPECTION + DELIVERY"]
        direction TB
        F{"Quality inspection passed?"} -->|No| G["Record defect and correct job"]
        G --> F
        F -->|Yes| H["Pickup or shipment receipt"]
    end
    INTAKE -->|All required data verified| PRODUCTION
    PRODUCTION -->|Completed item| QUALITY
