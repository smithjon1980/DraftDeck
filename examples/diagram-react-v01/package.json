{
  "name": "boss-diagram-react-v01",
  "version": "0.1.0",
  "private": true,
  "description": "BOSS: real Mermaid and PlantUML compiler evidence in React/Tailwind (synthetic only)",
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build:app": "esbuild src/main.jsx --bundle --minify --format=iife --loader:.jsx=jsx --outfile=dist/main.js",
    "build": "npm run build:css && npm run build:app",
    "render:browser": "node scripts/render-browser.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "esbuild": "0.25.12",
    "puppeteer": "24.31.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17"
  }
}
