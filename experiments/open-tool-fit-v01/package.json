{
  "name": "boss-open-tool-fit-trial",
  "version": "0.1.0",
  "private": true,
  "description": "No-cost BOSS Mermaid-to-Excalidraw compatibility smoke test",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --platform=browser --format=iife --conditions=production --loader:.mmd=text --loader:.css=css --loader:.woff2=file --asset-names=assets/[name]-[hash] --outdir=dist",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "puppeteer": "24.31.0"
  }
}
