{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BOSS layer result",
  "type": "object",
  "required": [
    "run_id",
    "layer",
    "attempt",
    "status",
    "outputs",
    "evidence_refs"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "story",
        "art",
        "text"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_ESTABLISHED",
        "HOLD"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
